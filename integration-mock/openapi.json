    "/mock/business-deliveries": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "mock": {
                      "const": true
                    },
                    "deliveries": {
                      "maxItems": 1000,
                      "items": {
                        "properties": {
                          "mock": {
                            "const": true
                          },
                          "order_id": {
                            "type": "string"
                          },
                          "event_id": {
                            "type": "string"
                          },
                          "trace_id": {
                            "type": "string"
                          }
                        },
                        "type": "object"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                }
              }
            },
            "description": "Last 1000 synthetic business deliveries"
          }
        }
