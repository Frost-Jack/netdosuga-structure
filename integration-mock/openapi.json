    "/mock/business-emails": {
      "post": {
        "responses": {
          "405": {
            "description": "Wrong method"
          },
          "400": {
            "description": "Invalid synthetic request"
          },
          "200": {
            "description": "Synthetic success",
            "content": {
              "application/json": {
                "schema": {
